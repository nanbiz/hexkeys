<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only to download the dictionaries of the languages chosen in settings. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Speech input, asked for in settings. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- To open the password manager in use, whichever app that is. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CreditsActivity"
            android:label="@string/credits"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="false" />

        <activity
            android:name=".HelpActivity"
            android:label="@string/help_title"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="false" />

        <activity
            android:name=".LanguagesActivity"
            android:label="@string/languages"
            android:theme="@android:style/Theme.DeviceDefault"
            android:exported="false" />

        <service
            android:name=".HexInputMethod"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
